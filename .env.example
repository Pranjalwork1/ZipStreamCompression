# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token created via @BotFather on Telegram (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
# Used to send reported user issues directly to your Telegram.
TELEGRAM_BOT_TOKEN="8792212878:AAFWZbWrcEIYxJkQ-NvSMyRX0gXyQPf7x7s"

# TELEGRAM_CHAT_ID: Your Telegram user ID or channel/group ID (e.g. 123456789 or @mychannel)
# Used as the destination for incoming issue reports.
TELEGRAM_CHAT_ID="7722987775"

# Optional TURN server for WebRTC sessions across restrictive NAT/mobile networks.
TURN_SERVER_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""
