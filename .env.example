# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token created via @BotFather on Telegram (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
# Used to send reported user issues directly to your Telegram.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Your Telegram user ID or channel/group ID (e.g. 123456789 or @mychannel)
# Used as the destination for incoming issue reports.
TELEGRAM_CHAT_ID=""

# Optional TURN server for WebRTC sessions across restrictive NAT/mobile networks.
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Optional signaling/API backend. Local/self-hosted defaults to the current origin.
# VITE_BACKEND_URL=https://your-backend.example.com
# VITE_PUBLIC_APP_URL=https://zipstream.online

# LibreOffice conversion settings (defaults to auto-detection in PATH / system locations)
# LIBREOFFICE_PATH=/usr/bin/soffice
# WORD_CONVERT_TIMEOUT_MS=90000
# MAX_WORD_FILE_MB=100

# Umami Analytics Configuration
# VITE_UMAMI_WEBSITE_ID="your-website-id-here"
# VITE_UMAMI_SRC="https://cloud.umami.is/script.js"

# Sarvam AI Configuration (Additive intelligence layer - backend only)
SARVAM_ENABLED=false
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_DEFAULT_LANGUAGE=en-IN
SARVAM_MAX_DOCUMENT_CHARS=50000
SARVAM_MAX_CHAT_CHARS=12000
SARVAM_MAX_TTS_CHARS=2200
SARVAM_CHAT_RATE_LIMIT=20
SARVAM_SUMMARY_RATE_LIMIT=5
SARVAM_TRANSLATE_RATE_LIMIT=20
SARVAM_STT_RATE_LIMIT=10
SARVAM_TTS_RATE_LIMIT=15
